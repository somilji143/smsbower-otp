DATABASE_URL=postgresql://user:password@host:5432/dbname

# SmsBower reseller (activation) API — get your key at smsbower.app profile
SMSBOWER_BASE_URL=https://smsbower.online
SMSBOWER_API_KEY=your_api_key_here

# Only needed if you ALSO supply numbers to SmsBower via GSM modems (partner protocol)
PARTNER_API_KEY=your_partner_key_here

JWT_SECRET=change_this_to_a_random_secret_key_minimum_32_chars

# Admin panel login (http://yoursite/admin.html)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

PORT=3000
